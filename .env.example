# ---- Postgres (usado pelo docker-compose, pelo script de ingestao e pelo dbt) ----
POSTGRES_USER=dbt_user
POSTGRES_PASSWORD=dbt_password
POSTGRES_DB=data_warehouse
POSTGRES_HOST=localhost
# 5433 no host evita conflito com um Postgres local ja rodando na 5432
# (dentro do container a porta continua sendo a 5432)
POSTGRES_PORT=5433

# Porta do Adminer (UI web do banco)
ADMINER_PORT=8080

# ---- Ingestao ----
# Pares de moedas a coletar na AwesomeAPI (separados por virgula)
CURRENCY_PAIRS=USD-BRL,EUR-BRL,GBP-BRL,BTC-BRL
# Quantos dias de historico buscar por par (max. 360 na API)
HISTORY_DAYS=180
